# SPELLSTOCK / POTIONPULSE Environment Configuration
PORT=5001
NODE_ENV=development

# MongoDB Atlas Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/potionpulse?retryWrites=true&w=majority
# If omitted or offline, embedded in-memory MongoDB will activate automatically.
MONGODB_URI=

# CORS Settings (* allows web dashboard and Android emulator access)
CORS_ORIGIN=*
